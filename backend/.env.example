# =========================================================
# MIL-EVID backend configuration
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# =========================================================

# --- Application ---
APP_NAME=mil-evid
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# Example: postgresql+psycopg://user:password@localhost:5432/milevid
DATABASE_URL=postgresql+psycopg://milevid:milevid@localhost:5432/milevid
DB_POOL_SIZE=5
DB_BATCH_SIZE=1000

# --- ACLED (dynamic evidence) ---
# Endpoint/param names are placeholders — confirm against the actual
# ACLED API documentation for your access tier before use.
ACLED_API_URL=https://api.acleddata.com/acled/read
ACLED_USERNAME=
ACLED_PASSWORD=
ACLED_TIMEOUT_SECONDS=15
ACLED_MAX_RETRIES=3

# --- Retrieval models ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-MiniLM2-L6-H768

# --- Index locations ---
FAISS_INDEX_DIR=indexes/faiss
BM25_INDEX_DIR=indexes/bm25

# --- Retrieval tuning ---
BM25_TOP_K=50
DENSE_TOP_K=50
RRF_K=60
RERANK_TOP_N=20

# --- Preprocessing / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
NEAR_DUPLICATE_THRESHOLD=0.85
SHINGLE_SIZE=5

# --- Ingestion / storage locations ---
# RAW_DATA_DIR should contain ucdp/, icrc/, un_peacemaker/, sipri/ subfolders.
RAW_DATA_DIR=data/raw
# CHUNK_STORE_DIR holds chunk TEXT as local JSONL files (source of truth).
# Postgres stores metadata only — never full chunk text — to stay within
# small/free database storage tiers regardless of corpus size.
CHUNK_STORE_DIR=data/processed/chunks
# MVP scope control: comma-separated country names. Leave empty to disable
# filtering. Names are normalized/aliased — see modules/preprocessing/country_filter.py.
PRIMARY_COUNTRIES=China,France,Germany,India,Israel,Pakistan,Russia,United Kingdom,Ukraine,United States,Colombia,Palestine,North Korea

# --- Confidence scoring weights (must sum to 1.0) ---
WEIGHT_RELEVANCE=0.30
WEIGHT_AGREEMENT=0.20
WEIGHT_FRESHNESS=0.15
WEIGHT_SOURCE_RELIABILITY=0.15
WEIGHT_CLAIM_SUPPORT=0.20

# --- Thresholds ---
CONTRADICTION_CONFIDENCE_THRESHOLD=0.6
CLAIM_SUPPORT_THRESHOLD=0.5
